// Assignment 14: CI/CD - Jenkins Pipeline building Docker Image
// Job: Declarative-Pipeline-Demo (updated via Configure > Pipeline script)
//
// Prerequisite setup (run on host before this pipeline can build images):
//
//   docker stop myjenkins
//   docker rm myjenkins
//
//   docker run -d \
//     -p 8080:8080 -p 50000:50000 \
//     -v jenkins_home:/var/jenkins_home \
//     -v /var/run/docker.sock:/var/run/docker.sock \
//     --name myjenkins \
//     jenkins/jenkins:lts-jdk17
//
//   docker exec -u root myjenkins sh -c "apt-get update && apt-get install -y docker.io"
//   docker exec myjenkins docker --version
//
//   # Grant the jenkins user access to the mounted Docker socket
//   docker exec -u root myjenkins chmod 666 /var/run/docker.sock

pipeline {
    agent any

    parameters {
        string(name: 'GREETING_NAME', defaultValue: 'World', description: 'The name to use in the greeting')
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                echo 'Starting Git checkout...'
                git url: 'https://github.com/YHQZ1/Devops-Coursework.git', branch: 'main'
                echo 'Git checkout completed.'
            }
        }

        stage('Greeting') {
            steps {
                echo "Hello ${params.GREETING_NAME}"
            }
        }

        stage('Run Example Command') {
            steps {
                echo 'Executing a shell command...'
                sh 'echo "Hello from Declarative Pipeline!"'
                sh 'echo --- Reading README ---'
                sh 'cat README.md'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("Assignment - 8/my-flask-app") {
                    sh 'docker build -t my-flask-app:${BUILD_NUMBER} .'
                }
            }
        }
    }
}

// Verify the built image on the host:
//   docker exec myjenkins docker images | grep my-flask-app
